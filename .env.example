# Environment variables weft itself reads (documented here so `weft audit` on this
# repo has a declaration source; every value is optional).
WEFT_CACHE=                 # index directory (default: ~/.cache/weft)
WEFT_ORACLES=               # comma-separated oracle names, overrides weft.toml
WEFT_BLOCK_ON=              # reject | review | never
WEFT_ENV_DECLARED_IN=       # comma-separated extra env declaration files
WEFT_STACK=                 # pin the detected stack, e.g. python,fastapi
WEFT_USER_CONFIG=           # explicit user config path
